<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClinifyMobile.Views.PatientAppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinifyMobile.ViewModels"
    xmlns:cv="clr-namespace:ClinifyMobile.Converters"
    Title="{Binding Title}"
    BackgroundColor="#F4F7F6">

    <ContentPage.Resources>
        <cv:StatusColorConverter x:Key="StatusColor" />
        <cv:StatusLightColorConverter x:Key="StatusLightColor" />
        <cv:ZeroToBoolConverter x:Key="ZeroToBool" />
        <cv:InvertedBoolConverter x:Key="InvertedBool" />
        <cv:PastDateConverter x:Key="PastDate" />
        <cv:StringNotEmptyToBoolConverter x:Key="StringNotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Hero Section -->
        <Frame Grid.Row="0" BackgroundColor="#4A90D9" CornerRadius="0" HasShadow="False" Padding="24,32,24,32" Margin="0">
            <VerticalStackLayout Spacing="8">
                <Label Text="Meus Agendamentos" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label Text="Acompanhe suas consultas, horários e acesse as salas virtuais diretamente por aqui." FontSize="14" TextColor="#EBF4FF" />
                <Button Text="Sair" Command="{Binding LogoutCommand}" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" HorizontalOptions="Start" Margin="0,16,0,0" HeightRequest="36" Padding="16,0" />
            </VerticalStackLayout>
        </Frame>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="16">
            
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4A90D9" HorizontalOptions="Center" VerticalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding Appointments.Count, Converter={StaticResource ZeroToBool}}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <Label Text="📅" FontSize="48" HorizontalOptions="Center" />
                <Label Text="Nenhuma consulta encontrada" FontSize="18" FontAttributes="Bold" TextColor="#1A2E4A" HorizontalOptions="Center" />
                <Label Text="Você ainda não possui agendamentos marcados no momento." FontSize="14" TextColor="#8A9BB0" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Appointments}" IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBool}}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,16" Padding="16" BackgroundColor="White" CornerRadius="12" HasShadow="True" BorderColor="Transparent">
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                                
                                <!-- Date & Time -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                                    <Label Text="{Binding Date, StringFormat='{0:dd}'}" FontSize="24" FontAttributes="Bold" TextColor="#4A90D9" HorizontalOptions="Center" />
                                    <Label Text="{Binding Date, StringFormat='{0:MMM}'}" FontSize="12" TextColor="#8A9BB0" TextTransform="Uppercase" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="🕒" FontSize="14" TextColor="#8A9BB0" VerticalOptions="Center" />
                                    <Label Text="{Binding Time}" FontSize="14" FontAttributes="Bold" TextColor="#4A5568" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- Doctor Info & Status -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto, *, Auto" Margin="0,16,0,16">
                                    <Frame Grid.Column="0" HeightRequest="40" WidthRequest="40" CornerRadius="20" BackgroundColor="#EBF4FF" Padding="0" HasShadow="False" VerticalOptions="Center">
                                        <Label Text="{Binding Doctor.Name, StringFormat='{0:1}'}" FontSize="16" FontAttributes="Bold" TextColor="#4A90D9" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0">
                                        <Label Text="{Binding Doctor.Name}" FontSize="16" FontAttributes="Bold" TextColor="#1A2E4A" />
                                        <Label Text="Telemedicina" FontSize="12" TextColor="#8A9BB0" />
                                    </VerticalStackLayout>

                                    <!-- Status Pill -->
                                    <Frame Grid.Column="2" Padding="8,4" CornerRadius="12" BackgroundColor="{Binding Status, Converter={StaticResource StatusLightColor}}" HasShadow="False" VerticalOptions="Center">
                                        <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold" TextColor="{Binding Status, Converter={StaticResource StatusColor}}" />
                                    </Frame>
                                </Grid>

                                <!-- Actions -->
                                <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2">
                                    <BoxView HeightRequest="1" BackgroundColor="#EDF2F7" Margin="0,0,0,12" />
                                    
                                    <!-- Entrar na Sala -->
                                    <Button Text="Entrar na Sala de Vídeo" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PatientAppointmentsViewModel}}, Path=JoinVideoCommand}" CommandParameter="{Binding MeetingUrl}" IsVisible="{Binding MeetingUrl, Converter={StaticResource StringNotEmpty}}" BackgroundColor="#27AE60" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44" />
                                    
                                    <!-- Aguardando / Encerrada -->
                                    <Label Text="Aguardando Liberação" IsVisible="{Binding MeetingUrl, Converter={StaticResource InvertedBool}}" TextColor="#8A9BB0" FontAttributes="Italic" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>
