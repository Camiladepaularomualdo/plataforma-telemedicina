<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClinifyMobile.Views.AgendaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinifyMobile.ViewModels"
    xmlns:models="clr-namespace:ClinifyMobile.Models"
    xmlns:helpers="clr-namespace:ClinifyMobile.Helpers"
    xmlns:converters="clr-namespace:ClinifyMobile.Converters"
    Title="Agenda"
    BackgroundColor="#F0F4FF">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,8,0">
            <Label
                Grid.Column="0"
                Text="Clinfy"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="Sair"
                Command="{Binding LogoutCommand}"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="14"
                Padding="0" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="#F0F4FF">

        <!-- ── Header: saudação + mês ── -->
        <Frame
            Grid.Row="0"
            BackgroundColor="#4A90D9"
            CornerRadius="0"
            Padding="20,16,20,20"
            HasShadow="False">
            <VerticalStackLayout Spacing="10">

                <!-- Saudação -->
                <Label
                    x:Name="GreetingLabel"
                    Text="{Binding DoctorName, StringFormat='Olá, {0}!'}"
                    TextColor="White"
                    FontSize="16"
                    Opacity="0.85" />

                <!-- Navegação de mês -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button
                        Grid.Column="0"
                        Text="‹"
                        Command="{Binding PreviousMonthCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="24"
                        Padding="8,0"
                        WidthRequest="44" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding MonthYearLabel}"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="2"
                        Text="›"
                        Command="{Binding NextMonthCommand}"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        FontSize="24"
                        Padding="8,0"
                        WidthRequest="44" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- ── Error Banner ── -->
        <Frame
            Grid.Row="1"
            BackgroundColor="#FDEDEC"
            BorderColor="#E74C3C"
            CornerRadius="8"
            Margin="16,8,16,0"
            Padding="12,8"
            IsVisible="{Binding HasError}"
            HasShadow="False">
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="#C0392B"
                FontSize="13" />
        </Frame>

        <!-- ── Lista de Agendamentos ── -->
        <RefreshView
            Grid.Row="2"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshColor="#4A90D9">

            <CollectionView
                ItemsSource="{Binding Days}"
                IsGrouped="True"
                EmptyView="Nenhum agendamento neste mês."
                Margin="16,8">

                <!-- Header do grupo (dia) -->
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Label
                            Text="{Binding DayLabel}"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#4A90D9"
                            Margin="0,14,0,6"
                            TextTransform="Uppercase" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <!-- Card de agendamento -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Appointment">
                        <Frame
                            Margin="0,0,0,8"
                            Padding="0"
                            CornerRadius="16"
                            BackgroundColor="White"
                            HasShadow="True">

                            <Grid ColumnDefinitions="6,*" RowDefinitions="*">

                                <!-- Barra colorida de status -->
                                <BoxView
                                    Grid.Column="0"
                                    Grid.RowSpan="1"
                                    CornerRadius="16,0,0,16"
                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />

                                <!-- Conteúdo do card -->
                                <Grid
                                    Grid.Column="1"
                                    Padding="14,12,14,12"
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions="*,Auto">

                                    <!-- Nome do paciente -->
                                    <Label
                                        Grid.Row="0" Grid.Column="0"
                                        Text="{Binding PatientName}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="#1A2E4A" />

                                    <!-- Badge de status -->
                                    <Frame
                                        Grid.Row="0" Grid.Column="1"
                                        Padding="8,3"
                                        CornerRadius="12"
                                        BackgroundColor="{Binding Status, Converter={StaticResource StatusLightColorConverter}}"
                                        HasShadow="False">
                                        <Label
                                            Text="{Binding StatusLabel}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
                                    </Frame>

                                    <!-- Data e Hora -->
                                    <Label
                                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                        FontSize="13"
                                        TextColor="#6B7A8D"
                                        Margin="0,4,0,0">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="🕐 " />
                                                <Span Text="{Binding FormattedTime}" />
                                                <Span Text="   📅 " />
                                                <Span Text="{Binding FormattedDate}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Ações do card -->
                                    <HorizontalStackLayout
                                        Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                        Spacing="8"
                                        Margin="0,10,0,0">

                                        <Button
                                            Text="Status"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UpdateStatusCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EBF4FF"
                                            TextColor="#4A90D9"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            HeightRequest="34" />

                                        <Button
                                            Text="E-mail"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SendEmailCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EAFAF1"
                                            TextColor="#27AE60"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            HeightRequest="34" />

                                        <Button
                                            Text="Sala"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GenerateMeetingCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#FFF8EC"
                                            TextColor="#F5A623"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            Padding="12,6"
                                            HeightRequest="34" />

                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- ── Bottom Action Bar ── -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,*,*"
            BackgroundColor="White"
            Padding="16,12"
            x:Name="BottomBar">

            <!-- Sombra -->
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.08" Radius="16" Offset="0,-4" />
            </Grid.Shadow>

            <Button
                Grid.Column="0"
                Text="+ Consulta"
                Command="{Binding GoToAddAppointmentCommand}"
                BackgroundColor="#4A90D9"
                TextColor="White"
                FontSize="13"
                FontAttributes="Bold"
                CornerRadius="12"
                Margin="0,0,4,0"
                HeightRequest="46" />

            <Button
                Grid.Column="1"
                Text="+ Paciente"
                Command="{Binding GoToAddPatientCommand}"
                BackgroundColor="#EBF4FF"
                TextColor="#4A90D9"
                FontSize="13"
                FontAttributes="Bold"
                CornerRadius="12"
                Margin="4,0"
                HeightRequest="46" />

            <Button
                Grid.Column="2"
                Text="Ver Todos"
                Command="{Binding GoToListCommand}"
                BackgroundColor="#F0F4FF"
                TextColor="#6B7A8D"
                FontSize="13"
                FontAttributes="Bold"
                CornerRadius="12"
                Margin="4,0,0,0"
                HeightRequest="46" />
        </Grid>

        <!-- Loading overlay -->
        <Grid
            Grid.RowSpan="4"
            BackgroundColor="#80000000"
            IsVisible="{Binding IsBusy}">
            <Frame
                BackgroundColor="White"
                CornerRadius="16"
                Padding="32"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HasShadow="True">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#4A90D9" />
                    <Label Text="Carregando..." TextColor="#4A5568" FontSize="14" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
