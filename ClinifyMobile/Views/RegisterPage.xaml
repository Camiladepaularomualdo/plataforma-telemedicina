<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClinifyMobile.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinifyMobile.ViewModels"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F0F4FF">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *" Padding="0">

            <!-- Background decoration top -->
            <BoxView
                Grid.Row="0"
                BackgroundColor="#4A90D9"
                HeightRequest="180"
                VerticalOptions="Start" />

            <!-- Card central -->
            <Frame
                Grid.Row="0"
                Grid.RowSpan="3"
                Margin="24,60,24,24"
                Padding="24,30,24,30"
                BackgroundColor="White"
                CornerRadius="24"
                HasShadow="True"
                VerticalOptions="Start">

                <VerticalStackLayout Spacing="0">

                    <!-- Título -->
                    <Label
                        Text="Criar Conta"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#1A2E4A"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Cadastre-se na Clinfy"
                        FontSize="13"
                        TextColor="#8A9BB0"
                        HorizontalOptions="Center"
                        Margin="0,4,0,24" />

                    <!-- Campo Nome -->
                    <Label Text="Nome Completo" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" Margin="0,0,0,6" />
                    <Frame Padding="4,0" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" Margin="0,0,0,12" HasShadow="False">
                        <Entry Text="{Binding Name}" Placeholder="Dr. João Silva" BackgroundColor="Transparent" TextColor="#1A2E4A" FontSize="15" Margin="8,4" ReturnType="Next" />
                    </Frame>

                    <!-- Campo E-mail -->
                    <Label Text="E-mail" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" Margin="0,0,0,6" />
                    <Frame Padding="4,0" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" Margin="0,0,0,12" HasShadow="False">
                        <Entry Text="{Binding Email}" Placeholder="seu@email.com" Keyboard="Email" BackgroundColor="Transparent" TextColor="#1A2E4A" FontSize="15" Margin="8,4" ReturnType="Next" />
                    </Frame>

                    <!-- Campo Senha -->
                    <Label Text="Senha" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" Margin="0,0,0,6" />
                    <Frame Padding="4,0" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" Margin="0,0,0,12" HasShadow="False">
                        <Entry Text="{Binding Password}" Placeholder="Mínimo 6 caracteres" IsPassword="True" BackgroundColor="Transparent" TextColor="#1A2E4A" FontSize="15" Margin="8,4" ReturnType="Next" />
                    </Frame>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <!-- Campo CPF -->
                            <Label Text="CPF" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" Margin="0,0,0,6" />
                            <Frame Padding="4,0" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" Margin="0,0,0,12" HasShadow="False">
                                <Entry Text="{Binding Cpf}" Placeholder="Apenas números" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="#1A2E4A" FontSize="15" Margin="8,4" ReturnType="Next" />
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <!-- Campo Telefone -->
                            <Label Text="Telefone" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" Margin="0,0,0,6" />
                            <Frame Padding="4,0" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" Margin="0,0,0,12" HasShadow="False">
                                <Entry Text="{Binding Phone}" Placeholder="(XX) 9XXXX-XXXX" Keyboard="Telephone" BackgroundColor="Transparent" TextColor="#1A2E4A" FontSize="15" Margin="8,4" ReturnType="Next" />
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Campo Data de Nascimento -->
                    <Label Text="Data de Nascimento" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" Margin="0,0,0,6" />
                    <Frame Padding="4,0" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" Margin="0,0,0,16" HasShadow="False">
                        <DatePicker Date="{Binding BirthDate}" Format="dd/MM/yyyy" BackgroundColor="Transparent" TextColor="#1A2E4A" FontSize="15" Margin="8,4" />
                    </Frame>

                    <!-- Mensagem de erro -->
                    <Label Text="{Binding ErrorMessage}" TextColor="#E74C3C" FontSize="13" IsVisible="{Binding HasError}" Margin="0,0,0,8" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                    <!-- Botão Cadastrar -->
                    <Button Text="Criar Conta e Entrar" Command="{Binding RegisterCommand}" BackgroundColor="#4A90D9" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="14" HeightRequest="52" Margin="0,8,0,16" />

                    <!-- Link Voltar Login -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Já tem conta?" TextColor="#8A9BB0" FontSize="14" VerticalOptions="Center" />
                        <Label Text="Voltar para Login" TextColor="#4A90D9" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Loading -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#4A90D9" Margin="0,12,0,0" HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>
