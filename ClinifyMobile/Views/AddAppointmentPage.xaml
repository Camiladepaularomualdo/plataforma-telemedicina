<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClinifyMobile.Views.AddAppointmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinifyMobile.ViewModels"
    Title="Novo Agendamento"
    BackgroundColor="#F0F4FF">

    <ScrollView>
        <Grid RowDefinitions="Auto,*" Padding="20,16">

            <!-- Cabeçalho -->
            <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="0,0,0,20">
                <Label Text="📅 Novo Agendamento"
                       FontSize="22" FontAttributes="Bold" TextColor="#1A2E4A" />
                <Label Text="Selecione o paciente, data e horário"
                       FontSize="14" TextColor="#8A9BB0" />
            </VerticalStackLayout>

            <!-- Formulário -->
            <Frame
                Grid.Row="1"
                BackgroundColor="White"
                CornerRadius="20"
                Padding="24"
                HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <!-- Paciente -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Paciente *" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" />
                        <Frame Padding="8,4" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" HasShadow="False">
                            <Picker
                                Title="Selecione um paciente"
                                ItemsSource="{Binding Patients}"
                                SelectedItem="{Binding SelectedPatient}"
                                TextColor="#1A2E4A"
                                TitleColor="#B0BEC5"
                                BackgroundColor="Transparent" />
                        </Frame>

                        <!-- Aviso se não há pacientes -->
                        <Label
                            Text="⚠️ Nenhum paciente cadastrado. Cadastre um antes de agendar."
                            FontSize="12"
                            TextColor="#F5A623"
                            IsVisible="{Binding Patients.Count, Converter={StaticResource ZeroToBoolConverter}}" />
                    </VerticalStackLayout>

                    <!-- Data -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Data da consulta *" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" />
                        <Frame Padding="8,4" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" HasShadow="False">
                            <DatePicker
                                Date="{Binding SelectedDate}"
                                Format="dd/MM/yyyy"
                                TextColor="#1A2E4A"
                                BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Horário -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Horário *" FontSize="13" FontAttributes="Bold" TextColor="#4A5568" />
                        <Frame Padding="8,4" BackgroundColor="#F7FAFF" BorderColor="#D1E3FF" CornerRadius="12" HasShadow="False">
                            <TimePicker
                                Time="{Binding SelectedTime}"
                                Format="HH:mm"
                                TextColor="#1A2E4A"
                                BackgroundColor="Transparent" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Erro -->
                    <Frame
                        BackgroundColor="#FDEDEC" BorderColor="#E74C3C"
                        CornerRadius="10" Padding="12,8"
                        IsVisible="{Binding HasError}" HasShadow="False">
                        <Label Text="{Binding ErrorMessage}" TextColor="#C0392B" FontSize="13" />
                    </Frame>

                    <!-- Botões -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="#F0F4FF"
                            TextColor="#6B7A8D"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="50" />

                        <Button
                            Grid.Column="1"
                            Text="Agendar"
                            Command="{Binding SaveCommand}"
                            BackgroundColor="#4A90D9"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="50" />
                    </Grid>

                    <!-- Loading -->
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="#4A90D9"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>
